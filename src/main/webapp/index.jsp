<%@ page contentType="text/html;charset=UTF-8" language="java" %>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AI Customer Support System</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f3f6fb;
            color: #263238;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            width: 90%;
            max-width: 750px;
            background: white;
            padding: 50px 40px;
            border-radius: 14px;
            text-align: center;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }

        h1 {
            color: #2457a7;
            font-size: 32px;
            margin-bottom: 18px;
        }

        .subtitle {
            color: #667085;
            font-size: 17px;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .status {
            display: inline-block;
            background: #e7f7ed;
            color: #218348;
            padding: 10px 18px;
            border-radius: 25px;
            font-weight: bold;
            margin-bottom: 25px;
        }

        .footer {
            color: #98a2b3;
            font-size: 13px;
            margin-top: 30px;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>AI Customer Support System</h1>

        <p class="subtitle">
            Welcome to our intelligent customer support and
            ticket management platform.
        </p>

        <div class="status">
            Web Application Running Successfully
        </div>

        <p>
            Your Java web application is now running on
            Apache Tomcat 9.
        </p>

        <div class="footer">
            AI Customer Support and Ticket Management System
        </div>

    </div>

</body>

</html>
